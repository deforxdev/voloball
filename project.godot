[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[internationalization]

locale/translations=PackedStringArray("res://game/translations/translations.en.translation", "res://game/translations/translations.uk.translation")

[physics]

common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.ios="mobile"
renderer/rendering_method.android="gl_compatibility"
gl_compatibility/driver.ios="opengl3"
rendering_device/driver="metal"
rendering_device/driver.windows="d3d12"
rendering_device/driver.ios="metal"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(1, 0.84, 0.24, 1)

